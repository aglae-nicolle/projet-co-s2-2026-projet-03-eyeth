---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="connexion" hideFooter={true} noAuth={true}>
    <Hero hideImage="true" />
    <h2>Content de vous revoir !</h2>

    <div
        class="flex flex-col items-center justify-center px-4 py-8 w-full max-w-md space-y-3"
    >
        <div class="relative border-bleu border bg-white rounded-lg pl-4 pt-2">
            <label class="block mb-2">Email</label>
            <input
                id="login-email"
                type="email"
                placeholder="vous@exemple.com"
                class="block w-full px-4 pb-3 focus:outline-none text-sm font-light"
            />
        </div>

        <div class="relative border-bleu border bg-white rounded-lg pl-4 pt-2">
            <label class="block mb-2">Mot de passe</label>
            <div class="relative">
                <input
                    id="login-password"
                    type="password"
                    placeholder="••••••••"
                    class="block w-full px-4 pb-3 focus:outline-none text-sm font-light"
                />
                <button
                    type="button"
                    onclick="togglePassword('login-password', this)"
                    class="absolute right-4 top-1/2 -translate-y-1/2 text-bleu text-lg"
                    >voir</button
                >
            </div>
        </div>

        <div id="login-error" class="hidden text-red-400 text-sm px-1"></div>

        <button
            id="login-btn"
            type="button"
            onclick="handleLogin()"
            class="group relative w-full flex justify-center py-3 px-4 my-6 border border-transparent rounded-lg text-white bg-bleu text-xl"
        >
            Se connecter
        </button>
    </div>

    <p class="text-center mt-4 font-light">
        Je n'ai pas de compte
        <a href="/signin" class="font-normal underline"> Inscription </a>
    </p>

    <p class="text-center text-bleu text-xs mt-6 tracking-wide">
        Session active jusqu'à la fermeture du navigateur
    </p>
</Layout>

<script type="module">
    import { loginUser } from "/src/js/backend.js";
    import { saveSession, isLoggedIn } from "/src/js/auth.js";

    if (isLoggedIn()) window.location.href = "/";

    window.togglePassword = (inputId, btn) => {
        const input = document.getElementById(inputId);
        const isText = input.type === "text";
        input.type = isText ? "password" : "text";
        btn.textContent = isText ? "voir" : "cacher";
    };

    window.handleLogin = async () => {
        const email = document.getElementById("login-email").value.trim();
        const password = document.getElementById("login-password").value;
        const errorEl = document.getElementById("login-error");
        const btn = document.getElementById("login-btn");

        errorEl.classList.add("hidden");

        if (!email || !password) {
            return showError(errorEl, "Veuillez remplir tous les champs.");
        }

        btn.textContent = "Connexion…";
        btn.disabled = true;

        try {
            const authData = await loginUser(email, password);
            saveSession(authData);
            window.location.href = "/";
        } catch (err) {
            showError(
                errorEl,
                err?.data?.message || "Email ou mot de passe incorrect.",
            );
        } finally {
            btn.textContent = "Se connecter";
            btn.disabled = false;
        }
    };

    document.addEventListener("keydown", (e) => {
        if (e.key === "Enter") window.handleLogin();
    });

    function showError(el, msg) {
        el.textContent = msg;
        el.classList.remove("hidden");
    }
</script>
