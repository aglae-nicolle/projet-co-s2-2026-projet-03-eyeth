---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import memoire from "../assets/memoire.webp";
import comingsoon from "../assets/comming_soon.webp";
import flechesGauche from "../assets/button_lightLeft.svg";
import flechesDroite from "../assets/button_lightRight.svg";
import Hero from "../components/Hero.astro";

const elements = [
    {
        nom: "Jeux du Mémory",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: memoire,
        href: "/jeuxMemory",
    },
    {
        nom: "Undercover",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: comingsoon,
        href: "#",
    },
    {
        nom: "Mots-mêlés",
        description:
            "Découvrez notre jeu du Memory dédié à l'apprentissage de la LSF conçu pour apprendre en s'amusant. Associez les cartes pour relier un signe au mot correspondant. Renforcez votre mémoire visuelle et enrichissez progressivement votre vocabulaire en LSF",
        image: comingsoon,
        href: "#",
    },
];
---

<Layout title="jeux" hideFooter="true">
    <Hero hideImage="true" />
    <div
        class="relative w-full h-[calc(100dvh-9.125rem)] max-w-5xl aspect-video bg-beige overflow-hidden group"
    >
        <div class="relative items-center h-full flex flex-col w-full">
            <div
                id="carousel-jeux"
                class="flex overflow-x-auto snap-x snap-mandatory gap-6 px-4 scroll-smooth [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden w-full"
            >
                {
                    elements.map((item) => (
                        <div class="w-full shrink-0 snap-center mx-3 flex flex-col justify-center gap-4">
                            <div class="font-semibold text-xl">{item.nom}</div>
                            <p>{item.description}</p>
                            <a
                                href={item.href}
                                class=" flex justify-center items-center bg-bleu text-beige rounded-lg w-47.25 h-10 "
                            >
                                Jouer dès maintenant
                            </a>
                            <Image
                                src={item.image}
                                alt="Image d'illustration"
                                class="max-w-75 mx-auto mt-5 object-cover"
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
    <div
        class="absolute bottom-5 left-0 right-0 flex justify-center gap-8 z-10"
    >
        <button
            id="btn-prev"
            class="rounded-full focus:outline-none"
            aria-label="Voir les jeux précédents"
        >
            <Image
                src={flechesGauche}
                alt="Précédent"
                class="w-8 h-8 object-contain drop-shadow-md"
            />
        </button>

        <button
            id="btn-next"
            class="rounded-full focus:outline-none"
            aria-label="Voir les jeux suivants"
        >
            <Image
                src={flechesDroite}
                alt="Suivant"
                class="w-8 h-8 object-contain drop-shadow-md"
            />
        </button>
    </div>
</Layout>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const carousel = document.getElementById("carousel-jeux");
        const btnPrev = document.getElementById("btn-prev");
        const btnNext = document.getElementById("btn-next");

        if (carousel && btnPrev && btnNext) {
            const scrollAmount = carousel.clientWidth * 0.8;

            btnPrev.addEventListener("click", () => {
                carousel.scrollBy({
                    left: -scrollAmount,
                    behavior: "smooth",
                });
            });

            btnNext.addEventListener("click", () => {
                carousel.scrollBy({
                    left: scrollAmount,
                    behavior: "smooth",
                });
            });
        }
    });
</script>
